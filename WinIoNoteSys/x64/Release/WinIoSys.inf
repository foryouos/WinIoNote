;
; WinIoSys.inf
;

[Version]
Signature="$WINDOWS NT$"
Class=System ; TODO: specify appropriate Class
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider=%ManufacturerName%
CatalogFile=WinIoSys.cat
DriverVer = 01/05/2026,11.11.14.490
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12
WinIoSys_Device_CoInstaller_CopyFiles = 11

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
WinIoSys.sys  = 1,,
;


;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%WinIoSys.DeviceDesc%=WinIoSys_Device, Root\WinIoSys ; TODO: edit hw-id

[WinIoSys_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
WinIoSys.sys

;-------------- Service installation
[WinIoSys_Device.NT.Services]
AddService = WinIoSys,%SPSVCINST_ASSOCSERVICE%, WinIoSys_Service_Inst

; -------------- WinIoSys driver install sections
[WinIoSys_Service_Inst]
DisplayName    = %WinIoSys.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\WinIoSys.sys

;
;--- WinIoSys_Device Coinstaller installation ------
;

[WinIoSys_Device.NT.CoInstallers]
AddReg=WinIoSys_Device_CoInstaller_AddReg
CopyFiles=WinIoSys_Device_CoInstaller_CopyFiles

[WinIoSys_Device_CoInstaller_AddReg]
;


[WinIoSys_Device_CoInstaller_CopyFiles]
;


[WinIoSys_Device.NT.Wdf]
KmdfService =  WinIoSys, WinIoSys_wdfsect
[WinIoSys_wdfsect]
KmdfLibraryVersion = 1.15

[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
ManufacturerName="<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "WinIoSys Installation Disk"
WinIoSys.DeviceDesc = "WinIoSys Device"
WinIoSys.SVCDESC = "WinIoSys Service"
